// BitLogic — Prisma schema
// Now: SQLite. Later: change provider to "postgresql" and use a Postgres DATABASE_URL.
// Keep field types portable. See docs/adr/ADR-006.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  /// CUSTOMER | ADMIN | STAFF
  role         String   @default("CUSTOMER")
  /// JSON string[] of StaffPermissionKey — ignored for ADMIN (full access)
  permissionsJson String @default("[]")
  passwordHash String
  /// Set when the buyer clicks the verification link (or when no email provider is configured).
  emailVerifiedAt DateTime?
  /// Bumped on password change/reset: every older session token stops working.
  sessionVersion  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
  authTokens   AuthToken[]
  loginEvents  LoginEvent[]
  activityLogs ActivityLog[]

  @@index([role])
}

/// One row per sign-in attempt. Staff analytics reads the last 7 days.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String   @default("")
  /// password
  method    String
  success   Boolean
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email, createdAt])
}

/// Who did what. userId is the staff or admin who acted.
model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String   @default("")
  entityId   String   @default("")
  summary    String
  ip         String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

/// One-time links: email verification and password reset. Only a SHA-256 hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// verify_email | reset_password
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

/// Product → Categories taxonomy
model CatalogCategory {
  id        String    @id
  name      String
  /// Storefront filter code: AI | STREAM | WORK | CREATE
  code      String    @default("AI")
  createdAt DateTime  @default(now())
  products  Product[]
}

/// Product → Warranties taxonomy
model WarrantyTemplate {
  id        String   @id
  name      String
  badge     String
  headline  String
  /// warranty | login-only
  kind      String   @default("warranty")
  days      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Product → Credential Types taxonomy
model CredentialScheme {
  id         String   @id
  name       String
  fieldsJson String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String           @default("")
  tagline          String           @default("")
  /// Display category name (denormalized from CatalogCategory.name)
  category         String
  categoryId       String?
  catalogCategory  CatalogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  platform         String           @default("")
  imageUrl         String?
  galleryJson      String           @default("[]")
  featuresJson     String           @default("[]")
  badge            String?
  sale             Boolean          @default(false)
  featured         Boolean          @default(false)
  isActive         Boolean          @default(true)
  /// Admin SKU
  sku              String           @default("")
  /// active = listed on storefront; draft = hidden (legacy out_of_stock/suspended → normalized in code)
  status           String           @default("active")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  plans            ProductPlan[]
  orderItems       OrderItem[]

  @@index([categoryId])
  @@index([status])
}

/// Homepage hero: up to 5 'main' slides and 2 'side' banners. Click target is none | product | category | url.
model HomeBanner {
  id        String   @id @default(cuid())
  /// main | side
  slot      String
  position  Int      @default(0)
  imageUrl  String
  width     Int      @default(0)
  height    Int      @default(0)
  alt       String   @default("")
  /// none | product | category | url
  linkType  String   @default("none")
  /// product slug, category code (AI | STREAM | WORK | CREATE) or URL/path
  linkValue String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot, position])
}

model ProductPlan {
  id                  String      @id @default(cuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Stable public plan key (e.g. cg-shared-1m) — also used as admin variant id when set
  code                String
  label               String
  durationLabel       String
  durationDays        Int
  priceBdt            Decimal
  warrantyBadge       String?
  warrantyType        String?
  warrantyHeadline    String?
  detailsJson         String      @default("[]")
  isActive            Boolean     @default(true)
  isDefault           Boolean     @default(false)
  credentialSchemeId  String?
  /// email_login | token | license_key | invite_link
  credentialType      String      @default("email_login")
  /// auto_vault | manual_dispatch
  deliveryMode        String      @default("auto_vault")
  stockDisplayMode    String      @default("exact_count")
  vpnRequired         Boolean     @default(false)
  vpnRegionNote       String      @default("")
  hasWarranty         Boolean     @default(true)
  warrantyDays        Int         @default(0)
  deviceLimit         String      @default("")
  importantNote       String      @default("")
  warningNote         String      @default("")
  optionDescription   String      @default("")
  specificationsJson  String      @default("[]")
  /// Where credentials come from: own | own_then_supplier | supplier_auto | supplier_manual
  sourcing            String      @default("own")
  /// fixed = admin sets priceBdt; auto = supplier cost x rate x (1 + markup) + flat, rounded up
  pricingMode         String      @default("fixed")
  markupPercent       Float       @default(20)
  markupFlatBdt       Int         @default(0)
  roundToBdt          Int         @default(10)
  /// Never sell below cost + this (taka)
  minMarginBdt        Int         @default(0)
  /// current = renew at today's price; locked = price first paid (or today's if lower)
  renewalPricing      String      @default("current")
  /// false = one-time plan (no renewals)
  renewable           Boolean     @default(true)
  /// Accept new orders when this plan has no credentials
  allowBackorder      Boolean?
  /// New-order window (UTC). Renewals are not blocked.
  availableFrom       DateTime?
  availableUntil      DateTime?
  /// Why auto pricing/selling is held (big jump, loss, no rate); empty = fine
  pricingAlert        String      @default("")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]
  supplierLinks       PlanSupplierLink[]

  @@unique([productId, code])
  @@index([productId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    String      @default("PENDING")
  totalBdt  Decimal     @default(0)
  /// Amount actually received so far (manual orders can be partial)
  paidBdt   Decimal     @default(0)
  /// unpaid | partial | paid
  paymentStatus String  @default("unpaid")
  /// storefront | admin
  source    String      @default("storefront")
  /// Guest proof returned at checkout (unguessable). Not a session cookie.
  accessToken String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([accessToken])
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  planId       String
  plan         ProductPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  qty          Int         @default(1)
  unitPriceBdt Decimal
  createdAt    DateTime    @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([planId])
}

/// Internal order notes: editable/deletable for 24h, then immutable history.
model OrderNote {
  id         String    @id @default(cuid())
  /// Order id (no FK: seeded/legacy orders may only exist as deliveries)
  orderId    String
  /// Optional: note applies to one delivery unit only
  deliveryId String?
  text       String
  authorName String    @default("Admin")
  /// note | no_credential (delivered without credential)
  kind       String    @default("note")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  editedAt   DateTime?

  @@index([orderId, createdAt])
}

/// Credential Vault inventory
model VaultCredential {
  id                 String   @id
  productId          String
  productName        String
  variantId          String
  variantName        String
  credentialType     String
  secretValue        String
  email              String?
  password           String?
  profilePin         String?
  noteBBCode         String?
  /// available | delivered | replaced | expired
  status             String   @default("available")
  /// Stock meyaad in days from addedAt (set on Credentials add).
  validDays          Int      @default(30)
  /// Absolute stock end date YYYY-MM-DD
  expiresAt          String?
  batchNote          String   @default("")
  addedAt            String
  assignedOrderId    String?
  assignedBuyerEmail String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId, variantId])
  @@index([status])
  @@index([expiresAt])
}

/// Fulfillment / order delivery + chat
model DigitalDelivery {
  id                      String   @id
  orderId                 String
  createdAtLabel          String
  deliveredAt             String?
  buyerName               String
  buyerEmail              String
  buyerPhone              String
  productId               String
  productName             String
  variantId               String
  variantName             String
  credentialType          String
  deliveryMode            String
  /// delivered | pending_dispatch | warranty_claim | replaced | revoked
  status                  String
  /// Current Vault row linked to this delivery (source of truth for secret)
  vaultCredentialId       String?
  /// Snapshot from ProductPlan at order time (not set when assigning credentials)
  vpnRequired             Boolean  @default(false)
  vpnRegionNote           String   @default("")
  hasWarranty             Boolean  @default(false)
  /// Snapshot from ProductPlan at order time
  warrantyDays            Int      @default(0)
  warrantyRemainingDays   Int      @default(0)
  /// Warranty clock for the current paid period ('YYYY-MM-DD HH:mm'). Starts at delivery, not at order.
  warrantyStartsAt        String?
  warrantyEndsAt          String?
  /// Early renewal: the next period's warranty, which takes over when it starts (never stacks).
  nextWarrantyStartsAt    String?
  nextWarrantyEndsAt      String?
  warrantyTerms           String   @default("")
  warrantyClaimReason     String?
  replacementHistoryCount Int      @default(0)
  loginInstructionsJson   String   @default("[]")
  customAdminNote         String   @default("")
  unreadChatCount         Int      @default(0)
  chatMessagesJson        String   @default("[]")
  pinned                  Boolean  @default(false)
  orderExpiresAt          String?
  credentialValidDays     Int      @default(30)
  credentialAssignedAt    String?
  credentialExpiresAt     String?
  renewalPending          Boolean  @default(false)
  /// '' | processing | delivered | needs_review | failed : supplier purchase state for this unit
  supplierState           String   @default("")
  /// Bumped on every server-side supplier write; a client save with an older value cannot overwrite fulfilment fields
  supplierRev             Int      @default(0)
  credentialClearedAt     String?
  /// Total units purchased on this ORD line
  orderQuantity           Int      @default(1)
  /// 1-based unit index within the order (1…orderQuantity)
  unitIndex               Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  credentialAudits        CredentialAudit[]

  @@index([status])
  @@index([orderId])
  @@index([vaultCredentialId])
  @@index([pinned])
  @@index([renewalPending])
  @@index([credentialExpiresAt])
}

/// Secret assign / replace history (production audit trail)
model CredentialAudit {
  id                  String          @id
  deliveryId          String
  delivery            DigitalDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  atLabel             String
  /// assigned | replaced | renewed | expired | cleared
  action              String
  /// vault | custom | system
  source              String
  secretValue         String
  previousSecretValue String?
  vaultCredentialId   String?
  note                String?
  credentialExpiresAt String?
  createdAt           DateTime        @default(now())

  @@index([deliveryId, createdAt])
  @@index([vaultCredentialId])
}

model SupportTicket {
  id           String   @id
  subject      String
  orderId      String
  deliveryId   String?
  buyerName    String
  buyerEmail   String
  buyerPhone   String
  productName  String
  category     String
  priority     String
  /// open | answered | closed
  status       String
  updatedAtLabel String
  unreadCount  Int      @default(0)
  messagesJson String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model AdminNotification {
  id         String   @id
  type       String
  orderId    String?
  deliveryId String?
  ticketId   String?
  title      String
  message    String
  timeLabel  String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read])
}

/// Admin CRM customer (may mirror User email)
model AdminSubscriber {
  id                    String   @id
  name                  String
  email                 String   @unique
  phone                 String   @default("")
  joinedAt              String
  /// active | past_due | suspended
  status                String   @default("active")
  /// subscriber | reseller | vip
  role                  String   @default("subscriber")
  subscriptionsJson     String   @default("[]")
  totalSpentBdt         Int      @default(0)
  ordersCount           Int      @default(0)
  warrantyClaimsCount   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model PaymentTransaction {
  id               String   @id
  orderId          String
  buyerName        String
  buyerEmail       String
  productSummary   String
  amountBdt        Int
  gateway          String
  senderNumberOrRef String
  trxId            String
  /// verified | pending_verification | refunded | rejected
  status           String
  /// purchase | renewal | manual
  kind             String   @default("purchase")
  deliveryId       String?
  /// Renewal only: comma-separated delivery ids this payment extends (empty = whole order)
  renewDeliveryIds String   @default("")
  /// Renewal only: the access period this payment paid for (YYYY-MM-DD), set when verified
  periodFrom       String?
  periodTo         String?
  /// When an admin verified it (local stamp)
  verifiedAtLabel  String?
  createdAtLabel   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([deliveryId])
  @@index([trxId])
}

model CouponCode {
  id            String   @id
  code          String   @unique
  discountType  String
  discountValue Int
  minSpendBdt   Int      @default(0)
  usedCount     Int      @default(0)
  maxUses       Int      @default(0)
  expiresAt     String
  /// active | expired | disabled
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Store-wide switches edited from Admin → Settings (maintenance, pause orders, announcement).
model StoreSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id             String   @id
  name           String
  fileName       String
  folder         String
  url            String
  dimensions     String   @default("")
  sizeKb         Int      @default(0)
  mimeType       String
  uploadedAt     String
  usedByProduct  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One reseller API connection (Pandora, Jaha, ...). The key is encrypted at rest.
model Supplier {
  id                String            @id @default(cuid())
  name              String
  /// adapter key: pandora | jaha | mock
  kind              String
  baseUrl           String
  apiKeyEnc         String
  apiKeyHint        String            @default("")
  currency          String            @default("USD")
  isEnabled         Boolean           @default(true)
  /// Kill switch for buying only (sync keeps running)
  purchasingEnabled Boolean           @default(true)
  syncIntervalMin   Int               @default(15)
  lowBalanceAlert   Float             @default(5)
  lastSyncAt        DateTime?
  /// ok | error | running
  lastSyncStatus    String            @default("")
  lastSyncError     String            @default("")
  balance           String            @default("")
  balanceAt         DateTime?
  webhookSecretEnc  String            @default("")
  webhookUrl        String            @default("")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  products          SupplierProduct[]
  orders            SupplierOrder[]
}

/// Cached catalog item of a supplier. Never deleted by sync (status removed instead).
model SupplierProduct {
  id              String             @id @default(cuid())
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /// Stable key inside the supplier: product id (+ '::' + variant id)
  externalId      String
  productRef      String
  variantRef      String             @default("")
  name            String
  variantName     String             @default("")
  category        String             @default("")
  description     String             @default("")
  period          String             @default("")
  /// Decimal string as sent by the supplier, e.g. "0.285"
  price           String
  currency        String
  /// null = supplier does not say
  stock           Int?
  /// available | out_of_stock | removed
  status          String             @default("available")
  minQty          Int                @default(1)
  maxQty          Int                @default(100)
  /// instant | automatic | manual
  deliveryType    String             @default("instant")
  needsBuyerInput Boolean            @default(false)
  previousPrice   String             @default("")
  priceChangedAt  DateTime?
  lastSeenAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  links           PlanSupplierLink[]

  @@unique([supplierId, externalId])
  @@index([status])
}

/// Which supplier items can fulfil one of our options, in priority order (0 = first).
model PlanSupplierLink {
  id                String          @id @default(cuid())
  planId            String
  plan              ProductPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  supplierProductId String
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  priority          Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@unique([planId, supplierProductId])
}

/// One purchase attempt for one customer unit. id doubles as the Idempotency-Key.
model SupplierOrder {
  id                String          @id
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierProductId String
  orderId           String
  deliveryId        String
  /// queued | processing | delivered | failed | needs_review | cancelled
  status            String          @default("queued")
  externalOrderId   String          @default("")
  externalStatus    String          @default("")
  quantity          Int             @default(1)
  unitCost          String          @default("")
  currency          String          @default("")
  costBdt           Int             @default(0)
  salePriceBdt      Int             @default(0)
  /// Exact body sent, so a retry re-sends the same request with the same key (never secrets)
  requestJson       String          @default("")
  attempts          Int             @default(0)
  nextPollAt        DateTime?
  errorCode         String          @default("")
  lastError         String          @default("")
  /// sha256 of the last delivery text seen (detects supplementary data)
  deliveryHash      String          @default("")
  /// Encrypted copy of what the supplier delivered (backup / evidence)
  resultEnc         String          @default("")
  productLabel      String          @default("")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deliveredAt       DateTime?

  @@index([status])
  @@index([orderId])
  @@index([deliveryId])
}

/// Every price change of an option: who/what changed it and from what to what.
model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  planCode  String
  planLabel String   @default("")
  /// price | cost | pricing
  field     String   @default("price")
  oldValue  String
  newValue  String
  /// admin | auto | supplier | rate | system
  source    String
  actor     String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/// Taka per one unit of a supplier currency (USD, USDT, ...).
model CurrencyRate {
  code       String   @id
  bdtPerUnit Float
  updatedBy  String   @default("")
  updatedAt  DateTime @updatedAt
}

/// Webhook event ids already processed (replay protection).
model SupplierWebhookEvent {
  id         String   @id
  receivedAt DateTime @default(now())
}

/// Managed IP blocklist and rate-limit violations.
model IpRule {
  id        String    @id @default(cuid())
  ip        String    @unique
  /// "blocked" | "flagged" | "whitelisted"
  status    String    @default("blocked")
  reason    String    @default("Rate limit exceeded")
  hitCount  Int       @default(1)
  expiresAt DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([ip])
}

/// Real-time incident telemetry & attack logs.
model SecurityEvent {
  id        String   @id @default(cuid())
  ip        String
  endpoint  String
  /// "rate_limit_429" | "ip_blocked_403" | "brute_force" | "credential_stuffing"
  action    String
  /// "info" | "warning" | "critical"
  severity  String   @default("warning")
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model MfsDevice {
  id          String      @id @default(cuid())
  deviceName  String
  phoneNumber String      @unique
  apiKey      String      @unique
  gateway     String      // all, bkash, nagad, rocket, upay
  status      String      @default("active") // active, paused, offline
  simSlot     String      @default("SIM 1")
  batteryPct  Int?
  isCharging  Boolean?
  lastSeenAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  smsLogs     MfsSmsLog[]

  @@index([apiKey])
  @@index([status])
}

model MfsSmsLog {
  id               String      @id @default(cuid())
  deviceId         String?
  device           MfsDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  gateway          String      // bkash, nagad, rocket, upay
  senderAddress    String      // bkash, 16216, Nagad, etc.
  senderNumber     String?     // customer mobile who sent money
  amount           Decimal
  balance          Decimal?
  trxId            String      @unique
  reference        String?
  rawSms           String
  receivedAt       DateTime    @default(now())
  status           String      @default("unmatched") // unmatched, matched, ignored
  matchedOrderId   String?
  verificationMode String?     // fifo_time_window, ref_order_id, trx_id, unique_amount, manual
  createdAt        DateTime    @default(now())

  @@index([trxId])
  @@index([status])
  @@index([gateway])
  @@index([senderNumber])
  @@index([amount])
  @@index([matchedOrderId])
}

