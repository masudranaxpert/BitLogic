# APP_URL: public address of the store. Email links (verify, reset password) use it.
# Always set it in production so links can't be steered by a forged Host header.
APP_URL="http://localhost:3000"

# DATABASE_URL — SQLite for local/dev (ADR-006).
# File path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# AUTH_SECRET — signs session JWTs (min 16 chars). Generate a long random string.
AUTH_SECRET="change-me-to-a-long-random-secret"

# Optional: separate key for vault/credential encryption at rest.
# If omitted, AUTH_SECRET is hashed for AES-256-GCM. Also encrypts saved email passwords/API keys:
# changing it later means re-entering them in Admin → Settings → Email.
# ENCRYPTION_KEY="another-long-random-secret"

# Set to 1 only for first-time bootstrap (empty DB). Prefer scripts/ensure-admin.ts.
# ALLOW_ADMIN_BOOTSTRAP=1

# Later (PostgreSQL), switch schema provider to postgresql and use e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bitlogic?schema=public"
